{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@maceip/ix-workbench-primitives": [
        "../../ix-workbench-primitives/src/index.ts",
        "../ix-workbench-primitives/src/index.ts"
      ],
      "@maceip/ix-workbench-primitives/styles.css": [
        "../../ix-workbench-primitives/src/ix-workbench.css",
        "../ix-workbench-primitives/src/ix-workbench.css"
      ]
    }
  },
  "include": ["src"]
}